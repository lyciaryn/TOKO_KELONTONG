# Add project specific R8 rules here.
# AGP will combine all keep rule files in src/main/keepRules to pass to R8

# Model data untuk Gson/Retrofit harus tetap utuh agar JSON bisa dipetakan di build release.
-keep class com.example.toko_kelontong.data.model.** { *; }
-keepattributes Signature, *Annotation*
